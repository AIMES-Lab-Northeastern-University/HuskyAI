# Copy to backend/.env and fill in. Never commit the real .env.

# --- AI providers ---
GOOGLE_API_KEY=            # Gemini (chat)
OPENAI_API_KEY=            # evaluator_v3 judges, session analysis
OPENAI_VECTOR_STORE_ID=    # rubric/exemplar store the judges search

# --- Database: set DATABASE_URL, or the SUPABASE_DB_* block. Neither = local SQLite. ---
DATABASE_URL=
# SUPABASE_DB_HOST=
# SUPABASE_DB_PORT=5432
# SUPABASE_DB_NAME=postgres
# SUPABASE_DB_USER=
# SUPABASE_DB_PASSWORD=    # the Postgres password, NOT the service_role key
# DB_POOL_SIZE=5
# DB_MAX_OVERFLOW=2

# --- Auth ---
JWT_SECRET=                # at least 32 characters when ENVIRONMENT=production
ENVIRONMENT=development
PLATFORM_ADMIN_EMAILS=     # comma-separated; synced to users.is_platform_admin on startup

# --- Multiple workers (see docs/multi-worker-deploy.md). Unset = one worker. ---
# REDIS_URL=redis://localhost:6379/0

# --- Behind a proxy: how to find the real client IP for rate limits ---
# CLIENT_IP_HEADER=X-Forwarded-For
# TRUSTED_PROXY_HOPS=1

# --- Password reset email ---
# RESEND_API_KEY=
# EMAIL_FROM=
# FRONTEND_BASE_URL=http://localhost:5173

# --- Research notice (consent gate) ---
# RESEARCH_NOTICE_VERSION=1       # raise when approved new wording ships
# RESEARCH_NOTICE_ALLOW_DECLINE=0
# ANONYMIZE_SALT=                 # stable salt for de-identified exports

# --- Seeds (non-production) ---
# SEED_CLASSROOM_CODE=HUSKYDMX
# SEED_PILOT_CODE=TRYHUSKY
